# Copy to .env.deploy and replace this key; use the same key in datathon's .env.
ENGINE_API_KEY=replace-with-a-random-secret
ENGINE_DEADLINE_S=210
ENGINE_STARTUP_TIMEOUT_S=600
MAX_UPLOAD_MB=100
ENGINE_RETAINED_JOBS=200
ENGINE_VLM_BACKEND=transformers
ENGINE_VLM_REPO=Qwen/Qwen3-VL-4B-Instruct
ENGINE_USE_VLM=1
ENGINE_DEVICE=cpu
ENGINE_CPU_THREADS=8
ENGINE_ONNX_THREADS=2
OMP_NUM_THREADS=8
OPENBLAS_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false
# Download weights first using the command in docs/deployment.md.
HF_HUB_OFFLINE=1
# Enable only after copying the fine-tuned detector checkpoint into its volume.
# ENGINE_DETECTOR_PATH=/app/weights/detector_ft
